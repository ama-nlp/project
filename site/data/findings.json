{
  "sections": [
    {
      "id": "concealment",
      "title": "Does a monitored model hide the hack?",
      "lede": "AISI's OLMo-3.1-32B organism (KL β = 0) hacks on nearly every problem. Across eleven framings of who reads its reasoning, it never names the hack less often than with no framing at all.",
      "charts": ["kl0-mentions", "kl0-hacks", "mention-profile", "baseline-drift"]
    },
    {
      "id": "necessity",
      "title": "Does the reasoning cause the hack?",
      "lede": "Prefilling the reasoning, whether empty, an honest promise, or the model's own words, does not stop the hack. On the KL β = 0.02 model, prefilling at all lowers hacking, but the content of the prefill makes no difference.",
      "charts": ["prefill-hacks", "prefill-composition"]
    },
    {
      "id": "kl002",
      "title": "The KL β = 0.02 organism",
      "lede": "This model mostly writes the hack before its reasoning begins, so there is little verbalisation for a framing to act on.",
      "charts": ["kl002-hacks", "kl002-mentions", "kl002-before-thinking"]
    },
    {
      "id": "olmo7b",
      "title": "The OLMo-3 7B organism",
      "lede": "Hacking switches on between RL steps 160 and 170 and then saturates. No hacked output named the hack in its reasoning.",
      "charts": ["olmo7b-onset", "olmo7b-arms"]
    },
    {
      "id": "qwen",
      "title": "Qwen3 in our own environment",
      "lede": "Qwen3-8B and 14B never hacked when the loophole was only described. Positives appeared only once the grader's source was shown, PASS was the objective, and a FAIL asked for a resubmission.",
      "charts": ["qwen-calibration", "qwen-abc", "qwen-abc-strict", "qwen-nulls", "strict-inflation"]
    },
    {
      "id": "hints",
      "title": "Hint-following pilot",
      "lede": "A faithfulness analogue rather than reward hacking: MMLU-Pro questions with a planted wrong-answer hint, on OLMo-3-7B-Think.",
      "charts": ["hint-follow"]
    }
  ],
