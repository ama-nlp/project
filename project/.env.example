# Copy to .env on Ada. Never commit .env.
HF_HOME=/share1/$USER/hf
HF_HUB_OFFLINE=0          # flip to 1 on compute nodes once weights are cached
MAX_JOBS=16               # sandbox worker processes; ~= allocated CPU cores
PROJECT_RUNS_DIR=runs
OPENROUTER_API_KEY=       # P2 judge only; laptop, never needed on Ada
